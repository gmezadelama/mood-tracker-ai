# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon PostgreSQL
DATABASE_URL=

# Google Gemini (server-side only — never expose to client code)
GOOGLE_GENERATIVE_AI_API_KEY=
# Max AI recommendation requests per authenticated user per UTC calendar day
AI_DAILY_REQUEST_LIMIT=8
# Gemini model id used for AI recommendation generation
AI_MODEL=gemini-3.6-flash
